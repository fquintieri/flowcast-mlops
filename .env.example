KAGGLE_API_TOKEN=sua_chave_secreta_aqui

MLFLOW_TRACKING_URI=endereo_url_ml_flow
MODEL_NAME=nome_do_seu_modelo

# Chave de assinatura de sessao do Airflow (obrigatoria; webserver e scheduler devem usar a mesma).
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=gere_uma_chave_aleatoria_aqui

# Parametros de ML (opcionais; se vazios, valem os padroes de ml_agent/src/config.py)
# Janela de holdout em dias, relativa a data maxima dos dados (padrao: 90)
HOLDOUT_DAYS=
# Metrica unica de decisao e early stopping: smape | mae | rmse (padrao: smape)
DECISION_METRIC=
# Melhora relativa minima para promover o Challenger (padrao: 0.01 = 1%)
MIN_IMPROVEMENT=
# Piora maxima tolerada no |bias|, em unidades de venda (padrao: 0.5)
MAX_BIAS_DEGRADATION=
